rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Identity & Structural Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isProtectedOwnerEmail(email) {
      return email is string && (
        email == 'ziadalsyyadi@gmail.com' ||
        email == 'user_967773633918_v1@qataba-blood.app'
      );
    }

    function isProtectedOwnerDoc(data) {
      return ('email' in data && isProtectedOwnerEmail(data.email)) ||
        ('phone' in data && data.phone == '773633918');
    }

    function isOwner() {
      return isSignedIn() && (
        (request.auth.token.email == 'ziadalsyyadi@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.email == 'user_967773633918_v1@qataba-blood.app'
      );
    }

    function supervisorPath(uid) {
      return /databases/$(database)/documents/supervisors/$(uid);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasSupervisorDoc() {
      return isSignedIn() && exists(supervisorPath(request.auth.uid));
    }

    function supervisorData() {
      return get(supervisorPath(request.auth.uid)).data;
    }

    function isActiveSupervisor() {
      return hasSupervisorDoc() &&
        supervisorData().isActive == true &&
        supervisorData().level in ['donor_admin', 'urgent_admin', 'support_admin', 'general_admin'];
    }

    function hasSupervisorPerm(perm) {
      return isActiveSupervisor() &&
        ('permissions' in supervisorData()) &&
        (supervisorData().permissions is map) &&
        (perm in supervisorData().permissions) &&
        supervisorData().permissions[perm] == true;
    }

    function hasLegacyAdminRole() {
      return isSignedIn() &&
        !hasSupervisorDoc() &&
        exists(userPath(request.auth.uid)) &&
        get(userPath(request.auth.uid)).data.role == 'admin';
    }

    // Granular Capability Functions (Database-Enforced RBAC)
    function canManageSupervisors() {
      return isOwner();
    }

    function canManageAppConfig() {
      return isOwner();
    }

    function canManageDonors() {
      return isOwner() || hasSupervisorPerm('manageDonors') || hasLegacyAdminRole();
    }

    function canManageUrgentRequests() {
      return isOwner() || hasSupervisorPerm('manageUrgentRequests') || hasLegacyAdminRole();
    }

    function canManageSupportChat() {
      return isOwner() || hasSupervisorPerm('manageSupportChat') || hasLegacyAdminRole();
    }

    function canManageHospitals() {
      return isOwner() || hasSupervisorPerm('manageHospitals') || hasLegacyAdminRole();
    }

    function canManageLocations() {
      return isOwner() || hasSupervisorPerm('manageLocations') || hasLegacyAdminRole();
    }

    function canManageSettings() {
      return isOwner() || hasSupervisorPerm('manageSettings') || hasLegacyAdminRole();
    }

    function canManageUsersRecovery() {
      return isOwner() || hasSupervisorPerm('manageUsersRecovery');
    }

    function isAnyActiveAdmin() {
      return isOwner() || isActiveSupervisor() || hasLegacyAdminRole();
    }

    function matchesActorLevel(actorLevel) {
      return (isOwner() && actorLevel == 'owner') ||
        (!isOwner() && isActiveSupervisor() && actorLevel == supervisorData().level) ||
        (!isOwner() && !hasSupervisorDoc() && hasLegacyAdminRole() && actorLevel == 'legacy_admin');
    }

    // 3. Domain Data Validation Helpers
    function isValidBloodType(bt) {
      return bt in ['O+', 'O-', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-'];
    }

    function isValidDonor(data) {
      return data.keys().hasAll(['userId', 'fullName', 'bloodType', 'phone', 'residence', 'isAvailable', 'allowContact']) &&
        data.keys().hasOnly(['userId', 'fullName', 'bloodType', 'phone', 'phoneVerified', 'residence', 'notes', 'lastDonationDate', 'isAvailable', 'allowContact', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
        isValidBloodType(data.bloodType) &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20 &&
        (!('phoneVerified' in data) || (data.phoneVerified is bool)) &&
        data.residence is string && data.residence.size() >= 2 && data.residence.size() <= 150 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('lastDonationDate' in data) || (data.lastDonationDate is string && data.lastDonationDate.size() <= 40)) &&
        data.isAvailable is bool &&
        data.allowContact is bool;
    }

    function isValidUrgentRequest(data) {
      return data.keys().hasAll(['userId', 'patientName', 'bloodType', 'unitsNeeded', 'hospital', 'contactName', 'contactPhone', 'urgencyLevel', 'status']) &&
        data.keys().hasOnly(['userId', 'patientName', 'bloodType', 'unitsNeeded', 'hospital', 'contactName', 'contactPhone', 'urgencyLevel', 'status', 'notes', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 && (data.userId == request.auth.uid || canManageUrgentRequests()) &&
        data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 100 &&
        isValidBloodType(data.bloodType) &&
        data.unitsNeeded is number && data.unitsNeeded >= 1 && data.unitsNeeded <= 20 &&
        data.hospital is string && data.hospital.size() >= 2 && data.hospital.size() <= 150 &&
        data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 100 &&
        data.contactPhone is string && data.contactPhone.size() >= 7 && data.contactPhone.size() <= 20 &&
        data.urgencyLevel in ['critical', 'urgent', 'normal'] &&
        data.status in ['open', 'fulfilled'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidSupervisorPermissions(perms) {
      return perms is map &&
        perms.keys().hasAll([
          'manageDonors',
          'manageUrgentRequests',
          'manageSupportChat',
          'manageHospitals',
          'manageLocations',
          'manageSettings',
          'manageUsersRecovery',
          'manageSupervisors'
        ]) &&
        perms.keys().hasOnly([
          'manageDonors',
          'manageUrgentRequests',
          'manageSupportChat',
          'manageHospitals',
          'manageLocations',
          'manageSettings',
          'manageUsersRecovery',
          'manageSupervisors'
        ]) &&
        perms.manageDonors is bool &&
        perms.manageUrgentRequests is bool &&
        perms.manageSupportChat is bool &&
        perms.manageHospitals is bool &&
        perms.manageLocations is bool &&
        perms.manageSettings is bool &&
        perms.manageUsersRecovery is bool &&
        perms.manageSupervisors == false;
    }

    function isValidSupervisor(data, supervisorId) {
      return data.keys().hasAll(['uid', 'displayName', 'level', 'permissions', 'isActive', 'assignedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'phone', 'email', 'level', 'permissions', 'isActive', 'assignedBy', 'assignedByName', 'notes', 'createdAt', 'updatedAt']) &&
        data.uid == supervisorId &&
        data.uid != request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 20 && data.phone != '773633918')) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160 && !isProtectedOwnerEmail(data.email))) &&
        data.level in ['donor_admin', 'urgent_admin', 'support_admin', 'general_admin'] &&
        isValidSupervisorPermissions(data.permissions) &&
        data.isActive is bool &&
        data.assignedBy == request.auth.uid &&
        (!('assignedByName' in data) || (data.assignedByName is string && data.assignedByName.size() <= 100)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 300));
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorName', 'actorLevel', 'actionType', 'createdAt']) &&
        data.keys().hasOnly(['actorUid', 'actorName', 'actorLevel', 'actionType', 'targetId', 'targetLabel', 'details', 'createdAt']) &&
        data.actorUid == request.auth.uid &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 100 &&
        data.actorLevel in ['owner', 'donor_admin', 'urgent_admin', 'support_admin', 'general_admin', 'legacy_admin'] &&
        matchesActorLevel(data.actorLevel) &&
        data.actionType is string && data.actionType.size() >= 2 && data.actionType.size() <= 80 &&
        (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128)) &&
        (!('targetLabel' in data) || (data.targetLabel is string && data.targetLabel.size() <= 160)) &&
        (!('details' in data) || (data.details is string && data.details.size() <= 600)) &&
        data.createdAt == request.time;
    }

    function isValidAccountRecoveryCreate(data) {
      return data.keys().hasAll(['phone', 'fullName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['phone', 'fullName', 'note', 'status', 'createdAt', 'updatedAt']) &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 15 && data.phone.matches('^[0-9]+$') &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
        data.status == 'pending' &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isValidRecoveryGrantCreate(data) {
      return data.keys().hasAll(['nextVersion', 'status', 'createdAt']) &&
        data.keys().hasOnly(['nextVersion', 'previousUid', 'previousDonorId', 'requestId', 'status', 'createdAt']) &&
        data.nextVersion is number && data.nextVersion >= 1 && data.nextVersion <= 50 &&
        (!('previousUid' in data) || (data.previousUid is string && data.previousUid.size() <= 128)) &&
        (!('previousDonorId' in data) || (data.previousDonorId is string && data.previousDonorId.size() <= 128)) &&
        (!('requestId' in data) || (data.requestId is string && data.requestId.size() <= 128)) &&
        data.status == 'active' &&
        data.createdAt == request.time;
    }

    function isValidRecoveryGrantUpdate(data) {
      return data.keys().hasAll(['nextVersion', 'status', 'createdAt']) &&
        data.keys().hasOnly(['nextVersion', 'previousUid', 'previousDonorId', 'requestId', 'claimedByUid', 'status', 'createdAt', 'usedAt', 'revokedAt']) &&
        data.nextVersion is number && data.nextVersion >= 1 && data.nextVersion <= 50 &&
        data.status in ['active', 'used', 'revoked'];
    }

    function isClaimingGrantAfter(grantId) {
      return isValidId(grantId) &&
        exists(/databases/$(database)/documents/recovery_grants/$(grantId)) &&
        get(/databases/$(database)/documents/recovery_grants/$(grantId)).data.status == 'active' &&
        getAfter(/databases/$(database)/documents/recovery_grants/$(grantId)).data.status == 'used' &&
        getAfter(/databases/$(database)/documents/recovery_grants/$(grantId)).data.claimedByUid == request.auth.uid;
    }

    function isValidWebsiteConfig(data) {
      return data.keys().hasAll(['websiteUrl']) &&
        data.keys().hasOnly(['websiteUrl', 'updatedAt', 'updatedBy']) &&
        data.websiteUrl is string &&
        data.websiteUrl.size() >= 10 &&
        data.websiteUrl.size() <= 500 &&
        data.websiteUrl.matches('^https?://[^\\s]+$') &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // 4. Supervisors & Audit Logs Collections (Strictly Owner-Controlled)
    match /supervisors/{supervisorId} {
      allow get: if canManageSupervisors() || (isSignedIn() && request.auth.uid == supervisorId);
      allow list: if canManageSupervisors();

      allow create: if canManageSupervisors() &&
        isValidId(supervisorId) &&
        isValidSupervisor(incoming(), supervisorId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if canManageSupervisors() &&
        isValidId(supervisorId) &&
        isValidSupervisor(incoming(), supervisorId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if canManageSupervisors() && isValidId(supervisorId);
    }

    match /admin_audit_logs/{logId} {
      allow get, list: if canManageSupervisors();
      allow create: if isAnyActiveAdmin() &&
        isValidId(logId) &&
        isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // 5. Donors Collection
    match /donors/{donorId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        isValidId(donorId) &&
        isValidDonor(incoming()) &&
        (incoming().userId == request.auth.uid || canManageDonors());

      allow update: if isSignedIn() &&
        isValidId(donorId) &&
        isValidDonor(incoming()) && (
          (
            (existing().userId == request.auth.uid || canManageDonors()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'bloodType', 'phone', 'phoneVerified', 'residence', 'notes', 'lastDonationDate', 'isAvailable', 'allowContact', 'updatedAt'
            ])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'updatedAt']) &&
            incoming().userId == request.auth.uid &&
            incoming().updatedAt == request.time &&
            existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            ('userId' in existing()) &&
            ('recoveredGrantId' in getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
            isClaimingGrantAfter(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.recoveredGrantId) &&
            ('previousUid' in get(/databases/$(database)/documents/recovery_grants/$(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.recoveredGrantId)).data) &&
            get(/databases/$(database)/documents/recovery_grants/$(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.recoveredGrantId)).data.previousUid == existing().userId
          )
        );

      allow delete: if isSignedIn() &&
        isValidId(donorId) &&
        (existing().userId == request.auth.uid || canManageDonors());
    }

    // 6. Urgent Requests Collection
    match /urgent_requests/{requestId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        isValidId(requestId) &&
        isValidUrgentRequest(incoming());

      allow update: if isSignedIn() &&
        isValidId(requestId) &&
        isValidUrgentRequest(incoming()) &&
        (existing().userId == request.auth.uid || canManageUrgentRequests()) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'patientName', 'bloodType', 'unitsNeeded', 'hospital', 'contactName', 'contactPhone', 'urgencyLevel', 'status', 'notes', 'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isValidId(requestId) &&
        (existing().userId == request.auth.uid || canManageUrgentRequests());
    }

    // 7. User Profiles (with Owner protection & strict no-self-escalation)
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        canManageSupervisors() ||
        canManageUsersRecovery() ||
        canManageSupportChat()
      );
      allow list: if canManageSupervisors() || canManageUsersRecovery();

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        (incoming().role == 'user' || (isOwner() && incoming().role == 'admin')) &&
        incoming().displayName is string && incoming().displayName.size() <= 100 &&
        (!('email' in incoming()) || (
          incoming().email is string &&
          incoming().email.size() <= 160 &&
          (!('email' in request.auth.token) || incoming().email == request.auth.token.email)
        ));

      allow update: if isValidId(userId) && (
        (
          isSignedIn() &&
          request.auth.uid == userId &&
          (incoming().role == existing().role || (isOwner() && incoming().role in ['user', 'admin'])) &&
          (!('email' in incoming()) || (
            incoming().email is string &&
            incoming().email.size() <= 160 &&
            (incoming().email == existing().get('email', '') ||
             ('email' in request.auth.token && incoming().email == request.auth.token.email))
          )) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'phone', 'phoneVerified', 'email', 'fcmToken', 'role', 'recoveredFromUid', 'recoveredGrantId', 'updatedAt'
          ])
        ) ||
        (
          isOwner() &&
          request.auth.uid != userId &&
          !isProtectedOwnerDoc(existing()) &&
          incoming().role in ['user', 'admin'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
        )
      );

      allow delete: if isValidId(userId) &&
        !isProtectedOwnerDoc(existing()) && (
          isOwner() ||
          (canManageUsersRecovery() && existing().role != 'admin' && !exists(supervisorPath(userId)))
        );
    }

    // 8. Phone Auth Records
    match /phone_auth/{phone} {
      allow get: if isSignedIn();
      allow list: if canManageSupervisors() || canManageUsersRecovery();

      allow create: if isSignedIn() &&
        isValidId(phone) &&
        !exists(/databases/$(database)/documents/phone_auth/$(phone)) &&
        incoming().keys().hasAll(['phone', 'version', 'userId']) &&
        incoming().keys().hasOnly(['phone', 'version', 'userId', 'grantId', 'updatedAt']) &&
        incoming().phone == phone &&
        incoming().phone is string &&
        incoming().phone.size() >= 7 && incoming().phone.size() <= 15 &&
        incoming().version is number &&
        incoming().version >= 1 && incoming().version <= 50 &&
        incoming().userId == request.auth.uid;

      allow update: if (
        (canManageUsersRecovery() || canManageSupervisors()) &&
        phone != '773633918' &&
        incoming().keys().hasAll(['phone', 'version', 'userId']) &&
        incoming().phone == phone &&
        incoming().userId is string && incoming().userId.size() <= 128 &&
        incoming().version is number && incoming().version >= 1 && incoming().version <= 50
      ) || (
        isSignedIn() &&
        isValidId(phone) &&
        incoming().keys().hasAll(['phone', 'version', 'userId', 'grantId', 'updatedAt']) &&
        incoming().keys().hasOnly(['phone', 'version', 'userId', 'grantId', 'updatedAt']) &&
        incoming().phone == phone &&
        incoming().userId == request.auth.uid &&
        incoming().version is number &&
        incoming().version > existing().version &&
        incoming().version <= 50 &&
        incoming().updatedAt == request.time &&
        isClaimingGrantAfter(incoming().grantId) &&
        ('previousUid' in get(/databases/$(database)/documents/recovery_grants/$(incoming().grantId)).data) &&
        get(/databases/$(database)/documents/recovery_grants/$(incoming().grantId)).data.previousUid == existing().userId
      );

      allow delete: if (canManageUsersRecovery() || canManageSupervisors()) && phone != '773633918';
    }

    // 9. Account Recovery Requests
    match /account_recovery_requests/{requestId} {
      allow read: if canManageUsersRecovery();

      allow create: if isValidId(requestId) &&
        isValidAccountRecoveryCreate(incoming());

      allow update: if (
        canManageUsersRecovery() &&
        isValidId(requestId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'grantId', 'nextVersion', 'matchedUid', 'approvedAt', 'revokedAt', 'usedAt', 'updatedAt']) &&
        incoming().status in ['pending', 'approved', 'used', 'revoked']
      ) || (
        isSignedIn() &&
        isValidId(requestId) &&
        existing().status == 'approved' &&
        incoming().status == 'used' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedAt', 'updatedAt']) &&
        incoming().usedAt == request.time &&
        incoming().updatedAt == request.time &&
        ('grantId' in existing()) &&
        isClaimingGrantAfter(existing().grantId)
      );

      allow delete: if canManageUsersRecovery() && isValidId(requestId);
    }

    // 10. Recovery Grants
    match /recovery_grants/{grantId} {
      allow get: if canManageUsersRecovery() || (isValidId(grantId) && grantId.matches('^[a-f0-9]{64}$'));
      allow list: if canManageUsersRecovery();

      allow create: if canManageUsersRecovery() &&
        isValidId(grantId) &&
        grantId.matches('^[a-f0-9]{64}$') &&
        isValidRecoveryGrantCreate(incoming());

      allow update: if isValidId(grantId) && isValidRecoveryGrantUpdate(incoming()) && (
        canManageUsersRecovery() || (
          isSignedIn() &&
          existing().status == 'active' &&
          incoming().status == 'used' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedByUid', 'usedAt']) &&
          incoming().claimedByUid == request.auth.uid &&
          incoming().usedAt == request.time
        )
      );

      allow delete: if canManageUsersRecovery() && isValidId(grantId);
    }

    // 11. App Settings (tiered: settings managers write announcements; donor managers can only append deletedDonors tombstones)
    match /settings/{settingId} {
      allow read: if true;
      allow create, delete: if canManageSettings() && isValidId(settingId);
      allow update: if isValidId(settingId) && (
        canManageSettings() ||
        (
          canManageDonors() &&
          settingId == 'global' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['deletedDonors', 'updatedAt']) &&
          incoming().deletedDonors is list &&
          incoming().deletedDonors.size() <= 5000 &&
          incoming().updatedAt == request.time
        )
      );
    }

    // 12. Remote App Configuration (Owner exclusive)
    match /appConfig/{configId} {
      allow read: if true;
      allow create: if canManageAppConfig() &&
        isValidId(configId) &&
        isValidWebsiteConfig(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if canManageAppConfig() &&
        isValidId(configId) &&
        isValidWebsiteConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['websiteUrl', 'updatedAt', 'updatedBy']) &&
        incoming().updatedAt == request.time;
      allow delete: if canManageAppConfig() && isValidId(configId);
    }

    // 13. Hospitals Directory
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if canManageHospitals() && isValidId(hospitalId);
    }

    // 14. Locations / Regions
    match /locations/{locationId} {
      allow read: if true;
      allow write: if canManageLocations() && isValidId(locationId);
    }

    // 15. Support Chat Conversations
    match /conversations/{userId} {
      allow read: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || canManageSupportChat());
      allow create, update: if isSignedIn() &&
        isValidId(userId) &&
        (request.auth.uid == userId || canManageSupportChat()) &&
        (!('userId' in incoming()) || incoming().userId == userId);
      allow delete: if canManageSupportChat() && isValidId(userId);

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || canManageSupportChat());
        allow create: if isSignedIn() &&
          isValidId(messageId) &&
          incoming().keys().hasAll(['senderId', 'text', 'isAdmin', 'createdAt']) &&
          incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 2000 &&
          incoming().senderId == request.auth.uid &&
          (
            (request.auth.uid == userId && incoming().isAdmin == false) ||
            (canManageSupportChat() && incoming().isAdmin == true)
          );
        allow update, delete: if canManageSupportChat();
      }
    }
  }
}
