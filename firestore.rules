rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ziadalsyyadi@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'user_967773633918_v1@qataba-blood.app') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidBloodType(bt) {
      return bt in ['O+', 'O-', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-'];
    }

    function isValidDonor(data) {
      return data.keys().hasAll(['userId', 'fullName', 'bloodType', 'phone', 'residence', 'isAvailable', 'allowContact']) &&
        data.keys().hasOnly(['userId', 'fullName', 'bloodType', 'phone', 'phoneVerified', 'residence', 'notes', 'lastDonationDate', 'isAvailable', 'allowContact', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
        isValidBloodType(data.bloodType) &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20 &&
        (!('phoneVerified' in data) || (data.phoneVerified is bool)) &&
        data.residence is string && data.residence.size() >= 2 && data.residence.size() <= 150 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('lastDonationDate' in data) || (data.lastDonationDate is string && data.lastDonationDate.size() <= 40)) &&
        data.isAvailable is bool &&
        data.allowContact is bool;
    }

    function isValidUrgentRequest(data) {
      return data.keys().hasAll(['userId', 'patientName', 'bloodType', 'unitsNeeded', 'hospital', 'contactName', 'contactPhone', 'urgencyLevel', 'status']) &&
        data.keys().hasOnly(['userId', 'patientName', 'bloodType', 'unitsNeeded', 'hospital', 'contactName', 'contactPhone', 'urgencyLevel', 'status', 'notes', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 && (data.userId == request.auth.uid || isAdmin()) &&
        data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 100 &&
        isValidBloodType(data.bloodType) &&
        data.unitsNeeded is number && data.unitsNeeded >= 1 && data.unitsNeeded <= 20 &&
        data.hospital is string && data.hospital.size() >= 2 && data.hospital.size() <= 150 &&
        data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 100 &&
        data.contactPhone is string && data.contactPhone.size() >= 7 && data.contactPhone.size() <= 20 &&
        data.urgencyLevel in ['critical', 'urgent', 'normal'] &&
        data.status in ['open', 'fulfilled'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidAccountRecoveryCreate(data) {
      return data.keys().hasAll(['phone', 'fullName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['phone', 'fullName', 'note', 'status', 'createdAt', 'updatedAt']) &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 15 && data.phone.matches('^[0-9]+$') &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
        data.status == 'pending' &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isValidRecoveryGrantCreate(data) {
      return data.keys().hasAll(['nextVersion', 'status', 'createdAt']) &&
        data.keys().hasOnly(['nextVersion', 'previousUid', 'previousDonorId', 'requestId', 'status', 'createdAt']) &&
        data.nextVersion is number && data.nextVersion >= 1 && data.nextVersion <= 50 &&
        (!('previousUid' in data) || (data.previousUid is string && data.previousUid.size() <= 128)) &&
        (!('previousDonorId' in data) || (data.previousDonorId is string && data.previousDonorId.size() <= 128)) &&
        (!('requestId' in data) || (data.requestId is string && data.requestId.size() <= 128)) &&
        data.status == 'active' &&
        data.createdAt == request.time;
    }

    function isValidRecoveryGrantUpdate(data) {
      return data.keys().hasAll(['nextVersion', 'status', 'createdAt']) &&
        data.keys().hasOnly(['nextVersion', 'previousUid', 'previousDonorId', 'requestId', 'claimedByUid', 'status', 'createdAt', 'usedAt', 'revokedAt']) &&
        data.nextVersion is number && data.nextVersion >= 1 && data.nextVersion <= 50 &&
        data.status in ['active', 'used', 'revoked'];
    }

    function isClaimingGrantAfter(grantId) {
      return isValidId(grantId) &&
        exists(/databases/$(database)/documents/recovery_grants/$(grantId)) &&
        get(/databases/$(database)/documents/recovery_grants/$(grantId)).data.status == 'active' &&
        getAfter(/databases/$(database)/documents/recovery_grants/$(grantId)).data.status == 'used' &&
        getAfter(/databases/$(database)/documents/recovery_grants/$(grantId)).data.claimedByUid == request.auth.uid;
    }

    function isValidWebsiteConfig(data) {
      return data.keys().hasAll(['websiteUrl']) &&
        data.keys().hasOnly(['websiteUrl', 'updatedAt', 'updatedBy']) &&
        data.websiteUrl is string &&
        data.websiteUrl.size() >= 10 &&
        data.websiteUrl.size() <= 500 &&
        data.websiteUrl.matches('^https?://[^\\s]+$') &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // Donors Collection
    match /donors/{donorId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        isValidId(donorId) &&
        isValidDonor(incoming()) &&
        (incoming().userId == request.auth.uid || isAdmin());

      allow update: if isSignedIn() &&
        isValidId(donorId) &&
        isValidDonor(incoming()) && (
          (
            (existing().userId == request.auth.uid || isAdmin()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'bloodType', 'phone', 'phoneVerified', 'residence', 'notes', 'lastDonationDate', 'isAvailable', 'allowContact', 'updatedAt'
            ])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'updatedAt']) &&
            incoming().userId == request.auth.uid &&
            incoming().updatedAt == request.time &&
            existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            ('userId' in existing()) &&
            ('recoveredGrantId' in getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
            isClaimingGrantAfter(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.recoveredGrantId) &&
            ('previousUid' in get(/databases/$(database)/documents/recovery_grants/$(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.recoveredGrantId)).data) &&
            get(/databases/$(database)/documents/recovery_grants/$(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.recoveredGrantId)).data.previousUid == existing().userId
          )
        );

      allow delete: if isSignedIn() &&
        isValidId(donorId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // Urgent Requests Collection
    match /urgent_requests/{requestId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        isValidId(requestId) &&
        isValidUrgentRequest(incoming());

      allow update: if isSignedIn() &&
        isValidId(requestId) &&
        isValidUrgentRequest(incoming()) &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'patientName', 'bloodType', 'unitsNeeded', 'hospital', 'contactName', 'contactPhone', 'urgencyLevel', 'status', 'notes', 'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isValidId(requestId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        (incoming().role == 'user' ||
         (((request.auth.token.email == 'ziadalsyyadi@gmail.com' && request.auth.token.email_verified == true) ||
           request.auth.token.email == 'user_967773633918_v1@qataba-blood.app') && incoming().role == 'admin')) &&
        incoming().displayName is string && incoming().displayName.size() <= 100;

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        (incoming().role == existing().role ||
         (((request.auth.token.email == 'ziadalsyyadi@gmail.com' && request.auth.token.email_verified == true) ||
           request.auth.token.email == 'user_967773633918_v1@qataba-blood.app') && incoming().role in ['user', 'admin'])) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'phone', 'phoneVerified', 'role', 'recoveredFromUid', 'recoveredGrantId', 'updatedAt'
        ]);

      allow delete: if isAdmin();
    }

    // Phone Auth Records: a phone can be claimed by its authenticated UID,
    // or updated atomically when consuming an admin-issued recovery grant.
    match /phone_auth/{phone} {
      allow get: if isSignedIn();
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
        isValidId(phone) &&
        !exists(/databases/$(database)/documents/phone_auth/$(phone)) &&
        incoming().keys().hasAll(['phone', 'version', 'userId']) &&
        incoming().keys().hasOnly(['phone', 'version', 'userId', 'grantId', 'updatedAt']) &&
        incoming().phone == phone &&
        incoming().phone is string &&
        incoming().phone.size() >= 7 && incoming().phone.size() <= 15 &&
        incoming().version is number &&
        incoming().version >= 1 && incoming().version <= 50 &&
        incoming().userId == request.auth.uid;

      allow update: if (
        isAdmin() &&
        incoming().keys().hasAll(['phone', 'version', 'userId']) &&
        incoming().phone == phone &&
        incoming().userId is string && incoming().userId.size() <= 128 &&
        incoming().version is number && incoming().version >= 1 && incoming().version <= 50
      ) || (
        isSignedIn() &&
        isValidId(phone) &&
        incoming().keys().hasAll(['phone', 'version', 'userId', 'grantId', 'updatedAt']) &&
        incoming().keys().hasOnly(['phone', 'version', 'userId', 'grantId', 'updatedAt']) &&
        incoming().phone == phone &&
        incoming().userId == request.auth.uid &&
        incoming().version is number &&
        incoming().version > existing().version &&
        incoming().version <= 50 &&
        incoming().updatedAt == request.time &&
        isClaimingGrantAfter(incoming().grantId) &&
        ('previousUid' in get(/databases/$(database)/documents/recovery_grants/$(incoming().grantId)).data) &&
        get(/databases/$(database)/documents/recovery_grants/$(incoming().grantId)).data.previousUid == existing().userId
      );

      allow delete: if isAdmin();
    }

    // Account Recovery Requests: guests can submit requests (no auth yet);
    // only admins can read/manage requests, or a user atomically marks their approved request used.
    match /account_recovery_requests/{requestId} {
      allow read: if isAdmin();

      allow create: if isValidId(requestId) &&
        isValidAccountRecoveryCreate(incoming());

      allow update: if (
        isAdmin() &&
        isValidId(requestId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'grantId', 'nextVersion', 'matchedUid', 'approvedAt', 'revokedAt', 'usedAt', 'updatedAt']) &&
        incoming().status in ['pending', 'approved', 'used', 'revoked']
      ) || (
        isSignedIn() &&
        isValidId(requestId) &&
        existing().status == 'approved' &&
        incoming().status == 'used' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedAt', 'updatedAt']) &&
        incoming().usedAt == request.time &&
        incoming().updatedAt == request.time &&
        ('grantId' in existing()) &&
        isClaimingGrantAfter(existing().grantId)
      );

      allow delete: if isAdmin() && isValidId(requestId);
    }

    // Recovery Grants: keyed by SHA-256(phone + code) without PII.
    // Cannot be listed by non-admins; single doc lookup requires exact unguessable hash ID.
    match /recovery_grants/{grantId} {
      allow get: if isAdmin() || (isValidId(grantId) && grantId.matches('^[a-f0-9]{64}$'));
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(grantId) &&
        grantId.matches('^[a-f0-9]{64}$') &&
        isValidRecoveryGrantCreate(incoming());

      allow update: if isValidId(grantId) && isValidRecoveryGrantUpdate(incoming()) && (
        isAdmin() || (
          isSignedIn() &&
          existing().status == 'active' &&
          incoming().status == 'used' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedByUid', 'usedAt']) &&
          incoming().claimedByUid == request.auth.uid &&
          incoming().usedAt == request.time
        )
      );

      allow delete: if isAdmin() && isValidId(grantId);
    }

    // App Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    // Remote App Configuration (e.g. appConfig/websiteUrl)
    match /appConfig/{configId} {
      allow read: if true;
      allow create: if isAdmin() &&
        isValidId(configId) &&
        isValidWebsiteConfig(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(configId) &&
        isValidWebsiteConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['websiteUrl', 'updatedAt', 'updatedBy']) &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(configId);
    }

    // Hospitals Directory
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(hospitalId);
    }

    // Locations / Regions
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(locationId);
    }

    // Support Chat Conversations
    match /conversations/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Chat Messages Subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(messageId);
        allow update, delete: if isAdmin();
      }
    }
  }
}
