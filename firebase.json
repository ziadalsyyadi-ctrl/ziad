{
  "firestore": {
    "database": "ai-studio-remixremixremix-797cdaa7-fcd3-4ecd-a13f-0cffe9a43f72",
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "ota",
      "public": "ota-dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
